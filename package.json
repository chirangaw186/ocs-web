{
  "name": "pavielle",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @pavielle/api dev",
    "dev:store": "pnpm --filter @pavielle/storefront dev",
    "dev:admin": "pnpm --filter @pavielle/admin dev"
  }
}
